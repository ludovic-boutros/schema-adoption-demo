<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %logger{1} - %msg%n"/>
    </Console>
  </Appenders>

  <Loggers>
    <!-- Kafka clients and Confluent serializers are chatty at INFO; keep them at WARN so our
         own producer/consumer log lines aren't buried during the demo. -->
    <Logger name="org.apache.kafka" level="WARN"/>
    <Logger name="io.confluent" level="WARN"/>

    <Logger name="com.example.kafka" level="INFO"/>

    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
