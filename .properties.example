# The service account behind API_KEY needs the ResourceOwner role on the
# "orders-demo" and "orders-demo-dlq" topics (Confluent Cloud RBAC) - this
# demo creates both topics automatically via AdminClient if they don't
# already exist, which requires Create/Describe/Alter permissions that
# ResourceOwner grants. You do not need to create either topic by hand.
BOOTSTRAP_SERVER=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
API_KEY=your-api-key
API_SECRET=your-api-secret
TOPIC=orders-demo
CLIENT_ID=orders-demo-client
GROUP_ID=orders-demo-consumer

# The same service account also needs permission to manage schemas for the
# "orders-demo-value" subject (Schema Registry RBAC is separate from cluster
# RBAC) - required starting with branch 03.
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
SR_API_KEY=your-sr-api-key
SR_API_SECRET=your-sr-api-secret
